# Desktop agent / hooks (no .env is read automatically; set in the shell or MCP config)
APP_ENV=development                     # production | development — read by the shared server logger
KANBAN_SA=                              # optional override; default ../kanban-secrets/sa.json next to the repo
FIRESTORE_EMULATOR_HOST=                # 127.0.0.1:8080 to use the emulator instead of the real project
KANBAN_PROJECT_ID=                      # emulator project id, default demo-kanban

# Web app: see packages/web/.env.example (VITE_FIREBASE_* values)
